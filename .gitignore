# dependencies
node_modules/

# builds
dist/
build/

# EXCEPTION: the vendored @plumtrips/shared build MUST be committed — it is the
# only copy that travels into the apps/backend subtree split (the App Runner
# mirror has no monorepo workspace to build it from). Regenerate via
# scripts/vendor-shared.mjs. Keep this negation below the `dist/` rule above.
!vendor/shared/dist/
!vendor/shared/dist/**

# env
.env
.env.*
!.env.example

# logs
logs/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# OS
.DS_Store
Thumbs.db

# editors
.vscode/
.idea/

# uploads & runtime files
uploads/

# provisioned artefacts (downloaded at build time — see ytDlpProvision.ts and
# geoipProvision.ts). bin/ already covers both; *.mmdb is belt-and-braces
# because the GeoLite2 database is ~70 MB AND non-redistributable under
# MaxMind's licence, so it must never be committable from anywhere.
bin/
*.mmdb

# puppeteer / playwright cache
.cache/

# tests & coverage
coverage/

# misc
*.pdf
*.zip
backend-src-tree.txt
