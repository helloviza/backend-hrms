# apps/backend/.env.development.example
#
# Reference for the LOCAL DEV config. Copy to `.env.development` (gitignored)
# and it is loaded automatically whenever NODE_ENV=development — which
# `pnpm dev` sets. See docs/dev-setup.md.
#
# WHY THIS FILE EXISTS
# `.env` is the only file the backend used to read, and on most machines it
# holds the PRODUCTION Atlas URI and the PRODUCTION S3 bucket. That made
# "run the dev server" mean "connect to production". `.env.development` is
# loaded BEFORE `.env` and wins on every key it declares, so the values below
# keep local development entirely off prod.
#
# THE RULE: every key that points at a real production resource must be
# declared here, even when the value is a placeholder. A key that is ABSENT
# here falls through to `.env` — which is exactly how a prod bucket would
# sneak back in.
#
# NEVER put a real credential in this file. It is an example, and it is
# committed.

NODE_ENV=development
PORT=8099

# ── Database — LOCAL ONLY ────────────────────────────────────────────────
# A local mongod. `pnpm dev:mongo` starts one on this address with a
# persistent dbPath under .devdata/. The seed script REFUSES to run against
# anything that is not a local host, so a prod URI here fails loudly.
MONGO_URI=mongodb://127.0.0.1:27017/plumbox_dev

# ── Auth ─────────────────────────────────────────────────────────────────
# Dev-only signing secrets. Any non-empty string works locally; they are not
# shared with, and must never match, the deployed ones.
JWT_SECRET=dev-only-jwt-secret-not-for-deployment
JWT_REFRESH_SECRET=dev-only-refresh-secret-not-for-deployment

# ── CORS ─────────────────────────────────────────────────────────────────
# The Vite dev server. Must match the port the frontend actually serves on.
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_DOMAIN=

# ── Uploads — LOCAL DISK, NOT S3 ─────────────────────────────────────────
# S3_ENDPOINT set to a local address keeps uploads off the real bucket. With
# no MinIO running, uploads fail locally rather than writing to production —
# which is the correct failure. Point S3_ENDPOINT at a MinIO container and
# fill the two keys below if you need uploads to actually work.
AWS_REGION=ap-south-1
S3_BUCKET=plumbox-dev-local
S3_ENDPOINT=http://127.0.0.1:9000
AWS_ACCESS_KEY_ID=dev-local
AWS_SECRET_ACCESS_KEY=dev-local
PRESIGN_TTL=900

# ── Third-party integrations — DISABLED IN DEV ───────────────────────────
# Blank rather than absent, deliberately: an absent key falls through to
# `.env` and would use the real credential. Blank means the integration is
# off locally, which is what you want — no live emails, no live WhatsApp,
# no TBO calls billed against the real account.
TBO_HOTEL_USERNAME=
TBO_HOTEL_PASSWORD=
TBO_ClientId=
TBO_UserName=
TBO_Password=
TBO_EndUserIp=127.0.0.1

# GEMINI_API_KEY is REQUIRED (config/env.ts throws on an empty value), so it
# gets an obviously-fake placeholder rather than a blank. AI calls fail at
# call time in dev, which is the correct behaviour — put a real key here only
# if you are specifically working on an AI feature.
GEMINI_API_KEY=dev-local-not-a-real-key
PIXABAY_API_KEY=

WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_GRAPH_VERSION=

SMTP_HOST=
SMTP_USER=
SMTP_PASS=

GMAIL_SERVICE_ACCOUNT_KEY_PATH=
TICKETING_INBOX_EMAIL=
TICKETING_CRON_ENABLED=false

INTAKE_WEBHOOK_SECRET=dev-local
TURNSTILE_SECRET=
TURNSTILE_DEV_BYPASS=true
MAXMIND_LICENSE_KEY=
LOCATION_IP_HASH_SALT=dev-local-salt

# ── Background work — OFF in dev ─────────────────────────────────────────
# Crons and the WhatsApp host are noise locally and can act on real data via
# third-party APIs. Off by default.
EOD_CRON_DISABLED=true
CRM_SALES_PULSE_DISABLED=true
WA_HOST=false
