# apps/backend/.env.development.example
#
# Reference for the LOCAL DEV config. Copy to `.env.development` (gitignored)
# and it is loaded automatically whenever NODE_ENV=development — which
# `pnpm dev` sets. See docs/dev-setup.md.
#
# WHY THIS FILE EXISTS
# `.env` is the only file the backend used to read, and on most machines it
# holds the PRODUCTION Atlas URI and the PRODUCTION S3 bucket. That made
# "run the dev server" mean "connect to production". `.env.development` is
# loaded BEFORE `.env` and wins on every key it declares, so the values below
# keep local development entirely off prod.
#
# THE RULE: every key that points at a real production resource must be
# declared here, even when the value is a placeholder. A key that is ABSENT
# here falls through to `.env` — which is exactly how a prod bucket would
# sneak back in.
#
# NEVER put a real credential in this file. It is an example, and it is
# committed.

NODE_ENV=development
PORT=8099

# ── Database — LOCAL ONLY ────────────────────────────────────────────────
# A local mongod. `pnpm dev:mongo` starts one on this address with a
# persistent dbPath under .devdata/. The seed script REFUSES to run against
# anything that is not a local host, so a prod URI here fails loudly.
MONGO_URI=mongodb://127.0.0.1:27017/plumbox_dev

# ── Auth ─────────────────────────────────────────────────────────────────
# Dev-only signing secrets. Any non-empty string works locally; they are not
# shared with, and must never match, the deployed ones.
JWT_SECRET=dev-only-jwt-secret-not-for-deployment
JWT_REFRESH_SECRET=dev-only-refresh-secret-not-for-deployment

# ── D2C consumer identity wall (helloviza.ai) ────────────────────────────
# REQUIRED, IN EVERY ENVIRONMENT INCLUDING THIS ONE. server.ts calls
# assertConsumerSecretIsolated() before it mounts a single router, and that
# refuses to start when CONSUMER_JWT_SECRET is unset OR equal to JWT_SECRET.
# Without the line below a fresh clone does not boot at all.
CONSUMER_JWT_SECRET=dev-only-CONSUMER-secret-distinct-from-jwt-secret

# MUST BE PRESENT AND EMPTY LOCALLY — and this is the subtle one.
# Unlike COOKIE_DOMAIN, an ABSENT CONSUMER_COOKIE_DOMAIN does not mean "omit
# the domain attribute": config/consumerAuth.ts falls back to the hardcoded
# ".helloviza.ai" (cookieDomainForPath). A browser on localhost rejects a
# cookie scoped to a domain it is not on, so the consumer session silently
# never persists — you log in, get a 200, and the next request is a 401.
# Empty restores host-only cookies, which is what localhost needs.
CONSUMER_COOKIE_DOMAIN=

# ── CORS ─────────────────────────────────────────────────────────────────
# The Vite dev server. Must match the port the frontend actually serves on.
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_DOMAIN=

# ── Uploads — LOCAL DISK, NOT S3 ─────────────────────────────────────────
# S3_ENDPOINT set to a local address keeps uploads off the real bucket. With
# no MinIO running, uploads fail locally rather than writing to production —
# which is the correct failure. Point S3_ENDPOINT at a MinIO container and
# fill the two keys below if you need uploads to actually work.
AWS_REGION=ap-south-1
S3_BUCKET=plumbox-dev-local
S3_ENDPOINT=http://127.0.0.1:9000
AWS_ACCESS_KEY_ID=dev-local
AWS_SECRET_ACCESS_KEY=dev-local
PRESIGN_TTL=900

# ── Third-party integrations — DISABLED IN DEV ───────────────────────────
# Blank rather than absent, deliberately: an absent key falls through to
# `.env` and would use the real credential. Blank means the integration is
# off locally, which is what you want — no live emails, no live WhatsApp,
# no TBO calls billed against the real account.
TBO_HOTEL_USERNAME=
TBO_HOTEL_PASSWORD=
TBO_ClientId=
TBO_UserName=
TBO_Password=
TBO_EndUserIp=127.0.0.1

# GEMINI_API_KEY is REQUIRED (config/env.ts throws on an empty value), so it
# gets an obviously-fake placeholder rather than a blank. AI calls fail at
# call time in dev, which is the correct behaviour — put a real key here only
# if you are specifically working on an AI feature.
GEMINI_API_KEY=dev-local-not-a-real-key
PIXABAY_API_KEY=

# OPENAI_API_KEY is REQUIRED for the same reason, but more sharply: the OpenAI
# client in services/video/videoIngest.service.ts is constructed AT MODULE
# LOAD and its constructor THROWS on an empty or missing key. server.ts
# imports that module transitively, so an absent value here does not degrade
# a feature — it crashes the whole backend at boot, before any router mounts.
# A placeholder is enough; the constructor only checks for non-empty.
OPENAI_API_KEY=dev-local-not-a-real-key
SERPAPI_API_KEY=

WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_GRAPH_VERSION=

SMTP_HOST=
SMTP_USER=
SMTP_PASS=

GMAIL_SERVICE_ACCOUNT_KEY_PATH=
TICKETING_INBOX_EMAIL=
TICKETING_CRON_ENABLED=false

INTAKE_WEBHOOK_SECRET=dev-local
TURNSTILE_SECRET=
TURNSTILE_DEV_BYPASS=true
MAXMIND_LICENSE_KEY=
LOCATION_IP_HASH_SALT=dev-local-salt

# ── Background work — OFF in dev ─────────────────────────────────────────
# Crons and the WhatsApp host are noise locally and can act on real data via
# third-party APIs. Off by default.
EOD_CRON_DISABLED=true
CRM_SALES_PULSE_DISABLED=true
# The TBO static-data refresh calls TBO at boot. Dev has blank TBO creds by
# design, so every call 401s — and each attempt writes a trace file into
# apps/backend/logs/tbo/, inside the tree `node --watch` watches. That write
# restarts the server, which re-runs the seed, which writes again: a restart
# loop that leaves the backend intermittently unreachable. Off in dev.
STATIC_DATA_REFRESH_DISABLED=true
WA_HOST=false

# ── Razorpay — TEST MODE ONLY in dev ─────────────────────────────────────
# Undocumented until now, though the code has read them since the SBT
# payment path shipped: routes/razorpay.webhook.ts and the SBT
# create-order endpoints read these straight off process.env (NOT through
# config/env.ts, which names Razorpay as one of its deliberate exceptions).
#
# Get these from the Razorpay dashboard with the TEST/LIVE toggle set to
# TEST. A test key id starts "rzp_test_"; a live one starts "rzp_live_".
# There is no mode flag in this codebase — the mode IS whichever key is
# configured, so a live key in a dev .env would take real money.
#
# Left BLANK on purpose. Every payment endpoint checks for them and
# returns a clean 503 ("payment gateway not configured") when absent, so
# the app runs fine without them; only paying is switched off.
#
# KEY_ID is publishable (it is sent to the browser to open checkout).
# KEY_SECRET and WEBHOOK_SECRET are server-only and must never be
# returned by any endpoint or logged.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Verifies the webhook signature: HMAC-SHA256 over the RAW request body
# (routes/razorpay.webhook.ts). Note: when this is unset and NODE_ENV is
# not "production", that route SKIPS signature verification entirely — a
# dev convenience worth knowing about before pointing a public tunnel at
# a local backend.
RAZORPAY_WEBHOOK_SECRET=

# ── PII field encryption (security/piiMasterKey.ts) ──────────────────────
# Base64 of 32 random bytes. In production this lives in the APP_SECRETS
# bundle (AWS Secrets Manager, plumtrips/backend/secrets) and is NEVER set
# as an individual App Runner env var.
#
# Left BLANK on purpose. Outside production, an absent key means the backend
# derives a DETERMINISTIC local dev key — deterministic so that data written
# on one `pnpm dev` boot still decrypts on the next (a random per-process key
# would read as database corruption after every restart). It is loud about
# it, and it is not a secret: anyone with this repository can compute it.
#
# In production an absent key THROWS at first use — encrypted fields cannot
# be read or written without it.
#
# Set one locally only to rehearse the real path:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_MASTER_KEY=
